      "fields": {
        "title": {
          "en-US": "How To Make Batch Brew Coffee  (Filter Coffee)"
        },
        "slug": {
          "en-US": "how-to-make-batch-brew-coffee"
        },
        "excerpt": {
          "en-US": "What is batch brew? Batch brew coffee offers a consistent, smooth cup that’s perfect for sharing or enjoying throughout the day."
        },
        "coverImage": {
          "en-US": {
            "sys": {
              "type": "Link",
              "linkType": "Asset",
              "id": "7MqiUSD0Tt0MOAboCdvmHb"
            }
          }
        },
        "content": {
          "en-US": {
            "nodeType": "document",
            "data": {
            },
            "content": [
              {
                "nodeType": "paragraph",
                "data": {
                },
                "content": [
                  {
                    "nodeType": "text",
                    "value": "What is batch brew? Batch brew coffee offers a consistent, smooth cup that’s perfect for sharing or enjoying throughout the day.",
                    "marks": [
                    ],
                    "data": {
                    }
                  }
                ]
              },
              {
                "nodeType": "paragraph",
                "data": {
                },
                "content": [
                  {
                    "nodeType": "text",
                    "value": "Join our hands-on workshops to learn the ideal coffee-to-water ratio, brewing time, and techniques for optimizing flavor extraction. Whether you're a coffee novice or a seasoned enthusiast, our expert tips will elevate your brewing skills and enhance your appreciation for quality coffee.",
                    "marks": [
                    ],
                    "data": {
                    }
                  }
                ]
              },
              {
                "nodeType": "paragraph",
                "data": {
                },
                "content": [
                  {
                    "nodeType": "text",
                    "value": "Or join our hands-on workshops in Tel Aviv to learn the ideal coffee-to-water ratio, the best grind size, and essential brewing techniques. Whether you're a beginner or an enthusiast, mastering batch brew will transform your morning routine and enhance your appreciation for specialty coffee.",
                    "marks": [
                    ],
                    "data": {
                    }
                  }
                ]
              },
              {
                "nodeType": "paragraph",
                "data": {
                },
                "content": [
                  {
                    "nodeType": "text",
                    "value": "​Want to learn more?",
                    "marks": [
                    ],
                    "data": {
                    }
                  }
                ]
              },
              {
                "nodeType": "paragraph",
                "data": {
                },
                "content": [
                  {
                    "nodeType": "text",
                    "value": "Come to one of our coffee workshops or order a group coffee workshop!",
                    "marks": [
                    ],
                    "data": {
                    }
                  }
                ]
              },
              {
                "nodeType": "embedded-asset-block",
                "data": {
